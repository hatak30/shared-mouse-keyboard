{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shared Mouse Keyboard",
  "version": "0.4.0",
  "identifier": "io.github.hatak.shared-mouse-keyboard",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shared Mouse & Keyboard",
        "width": 1120,
        "height": 800,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share mouse, keyboard and clipboard across computers",
    "longDescription": "Control several macOS, Windows and Linux computers on your local network with one mouse and keyboard, and share the clipboard (text, images and files) between them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-shared-mouse-keyboard.rules": "../packaging/linux/60-shared-mouse-keyboard.rules",
          "/usr/lib/modules-load.d/shared-mouse-keyboard.conf": "../packaging/linux/shared-mouse-keyboard-modules.conf"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBOTJCMTlGRDBBMUNCMzIKUldReXk2SFFuN0dTU3M5MEdqaHNaTkQxL0dFeWxkN3RURmJkVmRyOHJiKzZFRDFoTTNJQXNGZXoK",
      "endpoints": [
        "https://github.com/hatak30/shared-mouse-keyboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
